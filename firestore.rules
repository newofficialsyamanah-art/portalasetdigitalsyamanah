rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portal internal Syamanah: izin baca dan tulis untuk koleksi inventaris
    match /submissions/{id} {
      allow read, write: if true;
    }
    match /mikrotik/{id} {
      allow read, write: if true;
    }
  }
}
